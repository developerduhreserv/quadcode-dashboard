# Без этих переменных дашборд хранит данные в браузере (localStorage).
# С ними все участники работают с одной общей базой в Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Имя рабочего пространства в общей базе. Разные значения = разные независимые дашборды.
NEXT_PUBLIC_WORKSPACE=main

# «Пульс». Все необязательные: без ключа соответствующий источник просто не подключается.
ANTHROPIC_API_KEY=
X_BEARER_TOKEN=
THREADS_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
